; Inno Setup 6 Script for BitAxeTool (Windows 10 / 11)
; Produces a modern installer with desktop shortcut, start menu entry, and uninstaller.

#define MyAppName "BitAxeTool"
#define MyAppVersion "2.3.5"
#define MyAppPublisher "mrgoldsmitt"
#define MyAppPublisherURL "https://mrgoldsmitt.work"
#define MyAppURL "https://github.com/mrgoldsmitt/BitAxeTool"
#define MyAppExeName "BitAxeTool.exe"

[Setup]
AppId={{E68F99E5-7B81-4C55-A9D4-9C7881682B12}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppPublisherURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\{#MyAppName}
DisableProgramGroupPage=yes
DefaultGroupName={#MyAppName}
OutputDir=installer_output
OutputBaseFilename=BitAxeTool_Setup_v{#MyAppVersion}
SetupIconFile=assets\bitaxe_icon.ico
LicenseFile=LICENSE
Compression=lzma2/ultra64
SolidCompression=yes
WizardStyle=modern
ArchitecturesInstallIn64BitMode=x64compatible
PrivilegesRequired=lowest
UninstallDisplayIcon={app}\assets\bitaxe_icon.ico

[Languages]
Name: "german"; MessagesFile: "compiler:Languages\German.isl"
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
Name: "autostart"; Description: "BitAxeTool beim Start von Windows automatisch ausführen"; GroupDescription: "Autostart:"; Flags: unchecked

[Files]
; Dist files generated by build_windows.py (PyInstaller onedir output)
Source: "dist\BitAxeTool\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs; Excludes: "config.json,config.json.bak,logs,logs\*"
Source: "config.json"; DestDir: "{app}"; Flags: onlyifdoesntexist uninsneveruninstall
Source: "assets\bitaxe_icon.ico"; DestDir: "{app}\assets"; Flags: ignoreversion
Source: "LICENSE"; DestDir: "{app}"; Flags: ignoreversion
Source: "CHANGELOG.md"; DestDir: "{app}"; Flags: ignoreversion
Source: "Freigabe_Firewall.bat"; DestDir: "{app}"; Flags: ignoreversion
Source: "Start_Hintergrunddienst.vbs"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\assets\bitaxe_icon.ico"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\assets\bitaxe_icon.ico"; Tasks: desktopicon
Name: "{autoprograms}\BitAxeTool Firewall Freigeben"; Filename: "{app}\Freigabe_Firewall.bat"
Name: "{autoprograms}\BitAxeTool Hintergrunddienst starten"; Filename: "{app}\Start_Hintergrunddienst.vbs"

[Registry]
Root: HKCU; Subkey: "Software\Microsoft\Windows\CurrentVersion\Run"; ValueType: string; ValueName: "{#MyAppName}"; ValueData: """{app}\{#MyAppExeName}"" --headless"; Flags: uninsdeletevalue; Tasks: autostart

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

[UninstallDelete]
Type: filesandordirs; Name: "{app}\config.json.bak"
Type: filesandordirs; Name: "{app}\__pycache__"
